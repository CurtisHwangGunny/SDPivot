# Copy to deploy/.env.test and replace all placeholder secrets before use.
SDP_DB_HOST=WeKnora-postgres
SDP_DB_PORT=5432
SDP_DB_NAME=WeKnora
SDP_DB_USER=postgres
SDP_DB_PASSWORD=<CHANGE_ME>

SDP_REDIS_ADDR=WeKnora-redis:6379
SDP_REDIS_PASSWORD=
SDP_UPLOAD_DIR=/tmp/sdpivot-uploads

SDP_JWT_SECRET=<GENERATE_RANDOM_64CHAR>
SDP_ALLOWED_ORIGINS=
OP_BOOTSTRAP_ADMIN_EMAIL=
OP_BOOTSTRAP_ADMIN_PASSWORD=

SDP_BACKEND_PORT=8082
SDP_FRONTEND_PORT=3099
