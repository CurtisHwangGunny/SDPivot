# Copy to deploy/.env.op, replace every CHANGE_ME value, and keep that file out of version control.
# Generate the artifacts below, then run the read-only gate before every Compose config/build/up:
#   ./deploy/validate-op-deployment.sh deploy/.env.op
#   docker compose --env-file deploy/.env.op -f deploy/docker-compose.op.yml config --quiet
# The validator accepts only its documented literal KEY=VALUE whitelist and never sources the env file.
#
# Artifact preconditions for local image builds:
#   go build -trimpath -buildvcs=false -o frontend/sdpivot/sdp-server ./cmd/sdp-server
#   (cd frontend/sdpivot && npm ci && npm run build:op)
# `frontend/sdpivot/dist/index.html` must exist and `dist/ops.html` must not exist.
# Production minimum: 8 vCPU, 32 GB RAM, and 500 GB SSD. The Compose limits below are conservative
# admission controls for a 2-core/4-GB development server, not a production sizing recommendation.
# Terminate production TLS at a host reverse proxy, or mount a reviewed server-context TLS snippet and
# certificate files per frontend/sdpivot/nginx.tls.conf.example; never commit private keys.

COMPOSE_PROJECT_NAME=sdpivot-op

OP_DB_USER=sdpivot
OP_DB_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
OP_DB_NAME=sdpivot

OP_REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD
OP_REDIS_DB=0
OP_REDIS_PREFIX=sdpivot:

# Use independent random values. AES keys must each be exactly 32 bytes.
OP_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
OP_SDP_JWT_SECRET=CHANGE_ME_INDEPENDENT_RANDOM_SDP_JWT_SECRET
OP_TENANT_AES_KEY=CHANGE_ME_EXACTLY_32_BYTES_KEY
OP_SYSTEM_AES_KEY=CHANGE_ME_EXACTLY_32_BYTES_KEY

# Comma-separated browser origins allowed by the SDPivot API; no wildcard.
OP_ALLOWED_ORIGINS=https://CHANGE_ME.example.com

# Only the Nginx-based sdp-frontend service publishes a host port.
# Keep loopback when a host-level TLS reverse proxy fronts this stack.
OP_HTTP_BIND=127.0.0.1
OP_HTTP_PORT=8080

# Every image reference must use an explicit non-latest tag; production should prefer sha256 digests.
# OP_APP_IMAGE and OP_DOCREADER_IMAGE have no Compose defaults and fail closed until replaced.
# With `docker compose build`, these values are the output tags; without build, they identify images to pull/run.
OP_POSTGRES_IMAGE=paradedb/paradedb:v0.22.2-pg17
OP_REDIS_IMAGE=redis:7.0-alpine
OP_APP_IMAGE=CHANGE_ME_IMMUTABLE_APP_IMAGE
OP_DOCREADER_IMAGE=CHANGE_ME_IMMUTABLE_DOCREADER_IMAGE
OP_MIGRATION_IMAGE=sdpivot-op-migration:local
OP_SDP_BACKEND_IMAGE=sdpivot-op-backend:local
OP_SDP_FRONTEND_IMAGE=sdpivot-op-frontend:local

SDP_ENABLE_LEGACY_ALIAS=false
DISABLE_REGISTRATION=true
MAX_FILE_SIZE_MB=50
WEKNORA_ASYNQ_CONCURRENCY=2
CONCURRENCY_POOL_SIZE=2
SDP_DB_MAX_OPEN_CONNS=5
SDP_DB_MAX_IDLE_CONNS=2
SDP_DB_CONN_MAX_LIFETIME=10m
SDP_READY_TIMEOUT=3s
DOCREADER_PDF_FORCE_SCANNED=false
DOCREADER_ODL_MAX_WORKERS=1
TZ=Asia/Shanghai

# Optional build mirrors; blank uses upstream package registries.
APT_MIRROR=
APK_MIRROR_ARG=
