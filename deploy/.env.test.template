# smartKnora (随越·智枢) Test Environment Configuration
# Copy this file to .env and fill in the values

# ========== Database ==========
SMART_DB_HOST=WeKnora-postgres
SMART_DB_PORT=5432
SMART_DB_NAME=WeKnora
SMART_DB_USER=postgres
SMART_DB_PASSWORD=<CHANGE_ME>

# ========== Redis ==========
REDIS_ADDR=WeKnora-redis:6379
REDIS_PASSWORD=<CHANGE_ME>

# ========== JWT ==========
SMARTKNORA_JWT_SECRET=<GENERATE_RANDOM_64CHAR>

# ========== LLM (configure in test env) ==========
# Supported: hunyuan / deepseek / qwen / openai
SMARTKNORA_LLM_PROVIDER=deepseek
SMARTKNORA_LLM_API_KEY=<YOUR_API_KEY>
SMARTKNORA_LLM_BASE_URL=https://api.deepseek.com/v1
SMARTKNORA_LLM_MODEL=deepseek-chat

# ========== SMS (configure in test env) ==========
SMARTKNORA_SMS_PROVIDER=aliyun
SMARTKNORA_SMS_ACCESS_KEY=<YOUR_ACCESS_KEY>
SMARTKNORA_SMS_ACCESS_SECRET=<YOUR_ACCESS_SECRET>
SMARTKNORA_SMS_SIGN_NAME=随越智枢
SMARTKNORA_SMS_TEMPLATE_CODE=SMS_123456789

# ========== Frontend ==========
SMARTKNORA_FRONTEND_PORT=3099

# ========== WeKnora (existing services) ==========
WEKNORA_VERSION=latest
