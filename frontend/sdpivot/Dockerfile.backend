FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl tzdata && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY sdp-server .
RUN chmod +x sdp-server

# The statically linked binary resolves Jieba dictionaries at runtime.
# Keep them in an image-owned, stable path rather than a build-host GOPATH.
COPY deps/cppjieba/dict/ /app/gojieba-dict/
RUN test -r /app/gojieba-dict/jieba.dict.utf8 \
    && test -r /app/gojieba-dict/hmm_model.utf8 \
    && test -r /app/gojieba-dict/user.dict.utf8 \
    && test -r /app/gojieba-dict/idf.utf8 \
    && test -r /app/gojieba-dict/stop_words.utf8 \
    && chmod -R a+rX /app/gojieba-dict
ENV JIEBA_DICT_DIR=/app/gojieba-dict

RUN groupadd -r appgroup && useradd -r -g appgroup -s /usr/sbin/nologin appuser
USER appuser
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -f http://localhost:8081/health || exit 1
CMD ["./sdp-server"]
