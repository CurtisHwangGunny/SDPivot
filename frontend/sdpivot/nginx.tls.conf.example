# Optional TLS server-context override for private deployments.
# Copy this file outside the image, replace the placeholder certificate files,
# and mount it read-only as /etc/nginx/tls/tls.conf.
listen 443 ssl;
http2 on;
ssl_certificate /etc/nginx/certs/tls.crt;
ssl_certificate_key /etc/nginx/certs/tls.key;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SDPivotTLS:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
